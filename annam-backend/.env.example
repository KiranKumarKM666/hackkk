# Annam Backend Configuration Example
PORT=3000
NODE_ENV=development
DEMO_SHOW_OTP=true

# WhatsApp Cloud API Credentials
# Replace with your credentials from Meta for Developers
WHATSAPP_TOKEN=YOUR_WHATSAPP_TOKEN
WHATSAPP_PHONE_ID=YOUR_WHATSAPP_PHONE_ID

# Google Maps API Key
# Replace with your key from Google Cloud Console
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
